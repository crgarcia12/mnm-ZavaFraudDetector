  "rules": {
    "java-struts2-framework": {
      "title": "Modernize the Apache Struts 2 web framework",
      "description": "The application depends on **Apache Struts 2.5.30** and XML-configured actions, which increases modernization effort for newer Java stacks. Moving to a supported framework and reducing Struts-specific configuration will be required before broader runtime upgrades.",
      "severity": "mandatory",
      "effort": 13,
      "labels": [
        "domain=java-upgrade"
      ]
    },
    "jakarta-servlet-transition": {
      "title": "Move from javax servlet APIs to Jakarta-compatible APIs",
      "description": "The build still compiles against **javax.servlet 4.0.1** and deploys as a WAR. Modern Java application servers and frameworks increasingly require Jakarta namespaces, so API imports and deployment packaging will need review.",
      "severity": "potential",
      "effort": 8,
      "labels": [
        "domain=java-upgrade"
      ]
    },
    "war-tomcat-deployment": {
      "title": "Rework the WAR-based Tomcat deployment model for cloud hosting",
      "description": "The current delivery model builds a **ROOT.war** and runs it inside a dedicated Tomcat image. Cloud-native targets usually prefer self-contained processes, simplified container images, and clearer runtime ownership than an external servlet container layer.",
      "severity": "potential",
      "effort": 8,
      "labels": [
        "domain=cloud-readiness"
      ]
    },
    "raw-jdbc-sqlserver-coupling": {
      "title": "Reduce direct JDBC and SQL Server coupling",
      "description": "Business actions open JDBC connections directly and embed SQL statements inline. This creates tight coupling to SQL Server behavior, limits connection-pooling options, and makes future portability or observability improvements more difficult.",
      "severity": "potential",
      "effort": 5,
      "labels": [
        "domain=cloud-readiness"
      ]
    },
    "external-auth-gateway-dependency": {
      "title": "Externalize and harden the authentication gateway dependency",
      "description": "Cookie-based authentication depends on a fixed **WhoAmI** endpoint on a separate gateway service. Cloud deployment will need a more robust integration strategy, including secure transport and resilient endpoint configuration.",
      "severity": "potential",
      "effort": 5,
      "labels": [
        "domain=cloud-readiness"
      ]
    }
  },
